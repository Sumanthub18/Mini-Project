# ==============================================================================
# SCAM OR SAFE? — DAY 3 BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port & Environment
PORT=5000
FLASK_ENV=development
DEBUG=True

# --- AI Provider API Keys ---
# Google Gemini API Key (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Groq API Key (from https://console.groq.com/keys)
GROQ_API_KEY=

# Mistral AI API Key (from https://console.mistral.ai/api-keys/)
MISTRAL_API_KEY=

# --- Configurable AI Model Names ---
# Do not hardcode model names in logic; override them here if desired.
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-1.5-flash
MISTRAL_MODEL=mistral-small-latest

# --- Day 4 Fact-Checking & Web Search APIs ---
# Google Fact Check Tools API Key (https://toolbox.google.com/factcheck/apis)
GOOGLE_FACT_CHECK_API_KEY=

# Live Search Provider: tavily, serpapi, or auto (uses free Wikipedia knowledge fallback if unconfigured)
SEARCH_API_PROVIDER=auto
TAVILY_API_KEY=
SERPAPI_API_KEY=

# --- Supabase Configuration (Optional for backend privileged sync) ---
SUPABASE_URL=https://fhbocvfyueylnkpfhkev.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

